# ─── Staging environment ─────────────────────────────────────────────────────
# Loaded by Vite when running: vite --mode staging  /  vite build --mode staging
# Profile selector will pre-select "stage".

VITE_DEFAULT_PROFILE=stage

VITE_API_BASE_URL=https://stage.yourapp.com
VITE_WS_URL=wss://stage.yourapp.com/ws
VITE_WS_API_KEY=stage-api-key-67890
