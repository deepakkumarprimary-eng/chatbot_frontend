# ─── Production environment ──────────────────────────────────────────────────
# Loaded by Vite automatically on: vite build  (mode = production)
# Profile selector will pre-select "live".
# VITE_WS_API_KEY should be injected via CI/CD secrets — do not commit a real key here.

VITE_DEFAULT_PROFILE=live

VITE_API_BASE_URL=https://api.yourapp.com
VITE_WS_URL=wss://api.yourapp.com/ws
VITE_WS_API_KEY=
