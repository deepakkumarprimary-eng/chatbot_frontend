# ─── Development environment variables ───────────────────────────────────────
# These values are used automatically when running: npm run dev
# Do NOT commit real production keys here.

# REST API base URL — leave empty to use Vite proxy (recommended for dev)
VITE_API_BASE_URL=http://localhost:8080

# WebSocket URL — leave empty to use relative path /ws via Vite proxy.
# Using a relative path is required in dev so SockJS HTTP fallback transports
# (xhr_streaming, eventsource, xhr polling) are also proxied correctly.
# In production set this to the full backend URL: https://api.yourapp.com/ws
VITE_WS_URL=http://localhost:8080/ws

# WebSocket API key — must match websocket.api-key in application-dev.properties
VITE_WS_API_KEY=dev-api-key-12345
