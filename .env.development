# ─── Dev environment ─────────────────────────────────────────────────────────
# Loaded automatically by Vite when running: npm run dev
# Profile selector will pre-select "dev" when VITE_DEFAULT_PROFILE=dev

VITE_DEFAULT_PROFILE=dev

VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
VITE_WS_API_KEY=dev-api-key-12345
