# ─── Environment variable template ───────────────────────────────────────────
# There is one .env file per Vite mode:
#
#   .env.development  →  npm run dev                (mode = development)
#   .env.staging      →  vite --mode staging        (mode = staging)
#   .env.production   →  vite build                 (mode = production)
#
# Copy this file to the relevant .env.<mode> and fill in the values.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
#
#   npm run dev          →  .env.development   (mode = development)
#   npm run stage        →  .env.staging        (mode = staging)
#   npm run live         →  .env.production     (mode = production)
#   npm run build        →  .env.production     (production build)
#   npm run build:stage  →  .env.staging        (staging build)
#   npm run build:live   →  .env.production     (production build)
# ─────────────────────────────────────────────────────────────────────────────

# Which profile the chatbot UI pre-selects on load: dev | stage | live
VITE_DEFAULT_PROFILE=dev

# REST API base URL (used by axios for /api calls)
VITE_API_BASE_URL=http://localhost:8080

# WebSocket endpoint for the STOMP/SockJS connection
VITE_WS_URL=ws://localhost:8080/ws

# API key sent in the X-API-Key STOMP connect header
# Must match websocket.api-key on the backend for the matching environment
VITE_WS_API_KEY=your-api-key-here
