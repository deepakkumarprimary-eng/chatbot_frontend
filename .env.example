# ─── Environment variable template ───────────────────────────────────────────
# Copy this file to .env.development (local dev) or .env.production (prod build)
# and fill in the values for your environment.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.

# REST API base URL
# Dev:  leave empty — Vite proxy handles /api → http://localhost:8080
# Prod: set to your backend origin, e.g. https://api.yourapp.com
VITE_API_BASE_URL=http://localhost:8080

# WebSocket URL
# Dev:  leave empty — defaults to relative path /ws, proxied by Vite.
#       IMPORTANT: do not set an absolute URL in dev (e.g. http://localhost:3000/ws)
#       because SockJS HTTP fallback transports would bypass the proxy.
# Prod: set to your backend WS origin, e.g. https://api.yourapp.com/ws
VITE_WS_URL=http://localhost:3000/w

# WebSocket API key
# Must match the websocket.api-key property configured on the backend.
# Dev:    dev-api-key-12345  (from application-dev.properties)
# Staging: staging-api-key-67890  (from application-staging.properties)
# Prod:   set via WEBSOCKET_API_KEY environment variable on the backend server
VITE_WS_API_KEY=dev-api-key-12345
